{
  "name": "@dice-roller/presenters",
  "version": "0.0.0",
  "private": true,
  "description": "Official result presenters for RPG Dice Roller.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "assets/dice"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*.svg": "./assets/dice/*.svg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dice-roller/presenters.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "npm run build && tsc --noEmit && vue-tsc --noEmit -p demo/tsconfig.json && tsc -p tests/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run build:demo",
    "test": "npm run build && node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.0.0"
  }
}
